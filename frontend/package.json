{
  "name": "markee-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "env:dev": "npx --yes vercel@65.17.0 env run --",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test:streaming-campaign": "tsx --test tests/streamingCampaign.test.ts",
    "test:1hive": "tsx --test tests/1hiveCampaign.test.ts",
    "test:keeper": "tsx --test tests/keeper.test.ts",
    "test:embed-prompt": "tsx --test tests/embedPrompt.test.ts",
    "test:amount-input": "tsx --test tests/amountInput.test.ts",
    "test:eth-amount": "tsx --test tests/ethAmount.test.ts",
    "test:numbers": "tsx --test tests/textBytes.test.ts tests/winAmount.test.ts tests/accountSpend.test.ts tests/markeeQuote.test.ts",
    "test:billboard": "tsx --test tests/billboardText.test.ts tests/githubBillboard.test.ts tests/concurrency.test.ts",
    "test:beneficiary": "tsx --test tests/beneficiary.test.ts",
    "test:board-registry": "tsx --test tests/boardRegistry.test.ts tests/boardMigration.test.ts tests/successorAliases.test.ts",
    "test:board-migration-redirects": "tsx --test tests/boardMigrationRedirects.test.ts",
    "test:board-kv": "tsx --test tests/boardKvMigration.test.ts",
    "test:tx-tracking": "tsx --test tests/txTracking.test.ts",
    "test:streaming-deposit": "tsx --test tests/streamingDeposit.test.ts",
    "test:review-regressions": "tsx --tsconfig tsconfig.moderation-tests.json --test tests/review-regressions.test.ts",
    "test:moderation": "tsx --tsconfig tsconfig.moderation-tests.json --test tests/moderationQueue.test.ts tests/moderation-route.test.ts tests/automatic-moderation.test.ts tests/moderation-security.test.ts tests/moderation-rules.test.ts tests/moderated-author.test.ts tests/board-moderation-policy.test.ts tests/board-ownership.test.ts tests/wallet-session.test.ts",
    "test:public-routes": "tsx --tsconfig tsconfig.moderation-tests.json --test tests/public-routes.test.ts",
    "test:email-notifications": "tsx --test tests/emailNotifications.test.ts",
    "backfill:notify-emails": "tsx bin/backfill-notify-email-index.ts",
    "test:eth-price": "tsx --tsconfig tsconfig.moderation-tests.json --test tests/eth-price.test.ts",
    "test:e2e": "playwright test",
    "start": "next start",
    "lint": "next lint",
    "test:sdk": "tsx --tsconfig tsconfig.moderation-tests.json --test tests/sdk.test.ts tests/community-preview.test.ts tests/sdk-platforms.test.ts tests/sdk-cache.test.ts tests/sdk-rpc-fallback.test.ts tests/sdk-sites.test.ts tests/sdk-checkout.test.ts tests/sdk-conversion.test.ts tests/checkout-alerts.test.ts",
    "test:sdk:fork": "tsx --test --test-concurrency=1 tests/sdk-fork.test.ts tests/sdk-community-fork.test.ts",
    "test:e2e:fork": "playwright test -c playwright.fork.config.ts",
    "test:rpc": "tsx --tsconfig tsconfig.moderation-tests.json --test tests/rpc-efficiency.test.ts tests/cachedChainRead.test.ts tests/listing-reader.test.ts tests/integration-domains.test.ts tests/github-sync-schedule.test.ts tests/rpc-logging.test.ts tests/migratedStreamingTotals.test.ts tests/rpc-monthly-forecast.test.ts tests/alchemy-usage-api.test.ts && node --test tests/fork-proxy.test.mjs",
    "test:rpc:usage": "TSX_TSCONFIG_PATH=tsconfig.moderation-tests.json node --import tsx tests/integration/moderation-rpc-usage.manual.ts"
  },
  "dependencies": {
    "@2toad/profanity": "3.3.0",
    "@apollo/client": "^3.8.5",
    "@privy-io/react-auth": "3.51.0",
    "@privy-io/wagmi": "^4.0.5",
    "@rainbow-me/rainbowkit": "^2.1.0",
    "@solana-program/memo": "0.10.0",
    "@stripe/crypto": "1.1.3",
    "@tanstack/react-query": "^5.56.0",
    "@vercel/analytics": "^1.4.1",
    "@vercel/functions": "3.10.1",
    "@vercel/kv": "^2.0.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "graphql": "^16.6.0",
    "graphql-request": "^6.1.0",
    "lucide-react": "^0.554.0",
    "next": "15.5.29",
    "parse5": "^7.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-twemoji": "^0.6.0",
    "recharts": "^2.10.0",
    "tailwind-merge": "^2.0.0",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.29",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
