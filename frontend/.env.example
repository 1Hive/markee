# Server-only production error reporting. Never prefix this variable with NEXT_PUBLIC_.
DISCORD_ERROR_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me

# Optional: same origin as existing Markee logins. Deploy checkout there first;
# it must share checkout KV, signing secret and Privy app with this API.
# MARKEE_CHECKOUT_ORIGIN=https://www.markee.xyz

# Sponsored USDC conversion verification requires a Base RPC with
# debug_traceTransaction + callTracer support. Without it verification fails closed;
# retry verification after fixing the RPC, never repeat the swap.
# MARKEE_RPC_8453=https://your-base-rpc
# ALCHEMY_BASE_URL is also supported when MARKEE_RPC_8453 is unset.

# Optional, server-only message profanity filter. Disabled unless exactly true.
# Review docs/sdk/automatic-moderation.md dictionary-quality gate before enabling.
FLAG_AUTO_MODERATION=false
