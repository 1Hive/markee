{
  "name": "@markee/sdk",
  "version": "0.1.0-alpha.1",
  "description": "Self-contained Markee modal and API client, with an optional React adapter.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" }
  },
  "scripts": {
    "build": "tsc && esbuild src/index.ts src/react.ts --bundle --format=esm --outdir=dist --external:react --minify",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": { "react": "^18.2.0 || ^19.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": { "@types/node": "^20.0.0", "@types/react": "^18.3.0", "esbuild": "^0.25.0", "tsx": "^4.22.4", "typescript": "^5.9.3" },
  "engines": { "node": ">=20" }
}
